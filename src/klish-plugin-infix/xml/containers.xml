<?xml version="1.0" encoding="UTF-8"?>
<KLISH
  xmlns="https://klish.libcode.org/klish3"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="https://src.libcode.org/pkun/klish/src/master/klish.xsd">

<PTYPE name="CONTAINERS">
  <COMPL>
    <ACTION sym="script">doas ixcont list</ACTION>
  </COMPL>
  <ACTION sym="STRING"/>
</PTYPE>

<PTYPE name="CONTAINERSa">
  <COMPL>
    <ACTION sym="script">doas ixcont -a list</ACTION>
  </COMPL>
  <ACTION sym="STRING"/>
</PTYPE>

<PTYPE name="IMAGES">
  <COMPL>
    <ACTION sym="script">doas ixcont list images</ACTION>
  </COMPL>
  <ACTION sym="STRING"/>
</PTYPE>

<PTYPE name="ARCHIVES">
  <COMPL>
    <ACTION sym="script">doas ixcont list oci</ACTION>
  </COMPL>
  <ACTION sym="STRING"/>
</PTYPE>

<VIEW name="main">

<COMMAND name="container" help="Manage containers, images, and volumes" mode="switch">
  <COMMAND name="prune" help="Clean up all unused images and volume data">
    <ACTION sym="script" in="tty" out="tty" interrupt="true">
      doas ixcont prune
    </ACTION>
  </COMMAND>

  <!-- alias for 'container shell' -->
  <COMMAND name="connect" help="Start a shell inside a container, if available">
    <PARAM name="name" ptype="/CONTAINERS" help="Container name" />
    <ACTION sym="script" in="tty" out="tty" interrupt="true">
      doas ixcont shell $KLISH_PARAM_name
    </ACTION>
  </COMMAND>

  <COMMAND name="exec" help="Execute command in a running container, default: sh">
    <PARAM name="name" ptype="/CONTAINERS" help="Container name" />
    <SWITCH name="optional" min="0">
      <COMMAND name="command" help="Command to run">
        <PARAM name="command" ptype="/STRING" help="Command to run"/>
      </COMMAND>
    </SWITCH>
    <ACTION sym="script" in="tty" out="tty" interrupt="true">
      if [ -z "$KLISH_PARAM_name" ]; then
        echo "Missing container name."
      else
        cmd=${KLISH_PARAM_command:-sh}
        doas ixcont exec $KLISH_PARAM_name $cmd
      fi
    </ACTION>
  </COMMAND>

  <COMMAND name="load" help="Load a container OCI archive (.tar, .tar.gz) as an image">
    <PARAM name="url" ptype="/ARCHIVES" help="Filename or URL, e.g. https://addr/rootfs-oci.tar.gz" />
    <SWITCH name="optional" min="0">
      <COMMAND name="name" help="Image name (default: archive name)">
        <PARAM name="name" ptype="/STRING" help="name"/>
      </COMMAND>
      <COMMAND name="creds" help="Credentials for remote access">
        <PARAM name="creds" ptype="/STRING" help="username[:password]"/>
      </COMMAND>
    </SWITCH>
    <ACTION sym="script" in="tty" out="tty" interrupt="true">
      creds=${KLISH_PARAM_creds:+-c $KLISH_PARAM_creds}
      doas ixcont $creds load $KLISH_PARAM_url $KLISH_PARAM_name
    </ACTION>
  </COMMAND>

  <COMMAND name="pull" help="Fetch a container image from a registry">
    <PARAM name="image" ptype="/STRING" help="Image reference, e.g. docker://ghcr.io/kernelkit/curios:edge" />
    <SWITCH name="optional" min="0">
      <COMMAND name="creds" help="Credentials">
        <PARAM name="creds" ptype="/STRING" help="username[:password]"/>
      </COMMAND>
    </SWITCH>
    <ACTION sym="script" in="tty" out="tty" interrupt="true">
      creds=${KLISH_PARAM_creds:+-c $KLISH_PARAM_creds}
      doas ixcont $creds pull $KLISH_PARAM_image
    </ACTION>
  </COMMAND>

  <COMMAND name="restart" help="Restart a crashed container">
    <PARAM name="name" ptype="/CONTAINERSa" help="Container name" />
    <ACTION sym="script" out="tty" interrupt="true">
      doas ixcont restart $KLISH_PARAM_name
    </ACTION>
  </COMMAND>

  <COMMAND name="run" help="Interactively run a container image, with optional command">
    <PARAM name="image" ptype="/IMAGES" help="Image name" />
    <SWITCH name="optional" min="0">
      <COMMAND name="command" help="Command to run">
        <PARAM name="command" ptype="/STRING" help="Command to run"/>
      </COMMAND>
    </SWITCH>
    <ACTION sym="script" in="tty" out="tty" interrupt="true">
      doas ixcont run $KLISH_PARAM_image ${KLISH_PARAM_command}
    </ACTION>
  </COMMAND>

  <COMMAND name="shell" help="Start a shell inside a container, if available">
    <PARAM name="name" ptype="/CONTAINERS" help="Container name" />
    <ACTION sym="script" in="tty" out="tty" interrupt="true">
      doas ixcont shell $KLISH_PARAM_name
    </ACTION>
  </COMMAND>

  <COMMAND name="start" help="Start a container">
    <PARAM name="name" ptype="/CONTAINERSa" help="Container name" />
    <ACTION sym="script" out="tty" interrupt="true">
      doas ixcont start $KLISH_PARAM_name
    </ACTION>
  </COMMAND>

  <COMMAND name="stop" help="Stop a container">
    <PARAM name="name" ptype="/CONTAINERS" help="Container name" />
    <ACTION sym="script" out="tty" interrupt="true">
      doas ixcont stop $KLISH_PARAM_name
    </ACTION>
  </COMMAND>

  <COMMAND name="upgrade" help="Upgrade image of a container (writable layer is lost!)">
    <PARAM name="name" ptype="/CONTAINERSa" help="Container name" />
    <SWITCH name="optional" min="0" max="1">
      <COMMAND name="reset-volumes" help="Delete named volumes, re-initialize from new image (all config lost!)" />
    </SWITCH>
    <ACTION sym="script" out="tty" interrupt="true">
      if env | grep -q 'reset-volumes' >/dev/null; then
          opt="-R"
      fi
      doas ixcont $opt upgrade $KLISH_PARAM_name
    </ACTION>
  </COMMAND>
</COMMAND>

<COMMAND name="show" help="Show system status and configuration files" mode="switch">

  <COMMAND name="container" help="Show container status">
    <SWITCH name="subcommands" min="0">
      <COMMAND name="all" help="Show all containers (default only running)">
        <ACTION sym="script">show container</ACTION>
      </COMMAND>
      <COMMAND name="log" help="Show container log (jumps to end), alias to 'show log container'">
	<ACTION sym="script" in="tty" out="tty" interrupt="true">
	  doas -u $USER cat /log/container |pager +G
	</ACTION>
      </COMMAND>
      <COMMAND name="images" help="Show container images">
        <ACTION sym="script" in="tty" out="tty" interrupt="true">
	  doas ixcont show images |pager
	</ACTION>
      </COMMAND>
      <COMMAND name="oci" help="Show OCI archives (for loading as image)">
        <ACTION sym="script" in="tty" out="tty" interrupt="true">
	  doas ixcont list oci |pager
	</ACTION>
      </COMMAND>
      <COMMAND name="stat" help="Show container resource usage">
	<ACTION sym="script" in="tty" out="tty" interrupt="true">
	  doas ixcont stat
	</ACTION>
      </COMMAND>
      <COMMAND name="usage" help="Show container disk usage">
        <ACTION sym="script" in="tty" out="tty" interrupt="true">
	  doas ixcont usage
	</ACTION>
      </COMMAND>
      <COMMAND name="volumes" help="Show container volumes">
        <ACTION sym="script" in="tty" out="tty" interrupt="true">
	  doas ixcont show volumes |pager
	</ACTION>
      </COMMAND>
    </SWITCH>

    <SWITCH name="optional" min="0" max="1">
      <PARAM name="name" ptype="/CONTAINERS" help="Container name for detailed view" />
    </SWITCH>
    <ACTION sym="script" in="tty" out="tty" interrupt="true">
      show container $KLISH_PARAM_name |pager
    </ACTION>
  </COMMAND>

</COMMAND>

</VIEW>
</KLISH>
