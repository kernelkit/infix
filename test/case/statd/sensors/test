#!/bin/sh
# Hand written operational data, no board in the test rig has these
# sensors: an SoC die temperature from hwmon (Microchip s5_temp), one
# from a thermal zone (cpu-thermal), and a fan, the first two under the
# CPU component.  The VPD is named "cpu", as on Alder, so the CPU
# component has another name.  yangerd's TestHardwareSyntheticSensors
# covers how they are found.

oper_xpaths="/ietf-hardware:hardware"

cli_commands="show-hardware"

. $(readlink -f $(dirname $0)/../test.sh)
main "$@"
