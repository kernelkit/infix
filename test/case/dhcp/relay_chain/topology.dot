graph "relay chain" {
	layout="neato";
	overlap="false";
	esep="+40";

        node [shape=record, fontname="DejaVu Sans Mono, Book"];
	edge [color="cornflowerblue", penwidth="2", fontname="DejaVu Serif, Book"];

	host [
	    label="host | { <mgmt1> mgmt1 | <mgmt2> mgmt2 | <mgmt3> mgmt3 | <mgmt4> mgmt4 }",
	    pos="0,12!",
	    requires="controller",
	];

        client [
	    label="{ <mgmt> mgmt | <link> link } | client",
	    pos="15,21!",

	    requires="infix",
	];

	sw1 [
	    label="{ <mgmt> mgmt | <down> down | <up> up } | sw1",
	    pos="15,15!",

	    requires="infix",
	];

	sw2 [
	    label="{ <mgmt> mgmt | <down> down | <up> up } | sw2",
	    pos="15,9!",

	    requires="infix",
	];

        server [
	    label="{ <mgmt> mgmt | <link> link } | server",
	    pos="15,3!",

	    requires="infix",
	];

	host:mgmt1 -- client:mgmt [requires="mgmt", color=lightgrey]
	host:mgmt2 -- sw1:mgmt    [requires="mgmt", color=lightgrey]
	host:mgmt3 -- sw2:mgmt    [requires="mgmt", color=lightgrey]
	host:mgmt4 -- server:mgmt [requires="mgmt", color=lightgrey]

	client:link -- sw1:down  [color=black]
	sw1:up      -- sw2:down  [color=black]
	sw2:up      -- server:link [color=black, fontcolor=black, headlabel="192.168.1.1/24"]
}
