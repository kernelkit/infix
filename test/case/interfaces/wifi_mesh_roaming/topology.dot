graph "wifi-mesh-roaming" {
	layout="neato";
	overlap="false";
	splines="true";
	esep="+10";

	node [shape=record, fontname="DejaVu Sans Mono, Book"];
	edge [color="cornflowerblue", penwidth="2", fontname="DejaVu Serif, Book"];

	host [
	    label="host | { <lan> lan | <mgmt1> mgmt1 | <mgmt2> mgmt2 | <mgmt3> mgmt3 | <mgmt4> mgmt4 }",
	    pos="5.4,0!",
	    color="gray", fontcolor="gray",
	    requires="controller",
	];

	gw1 [
	    label="{ <uplink> uplink | <mgmt> mgmt | <mesh> mesh } | gw1 | <ap> ap",
	    pos="7,1!",
	    requires="infix",
	];

	gw2 [
	    label="{ <mesh> mesh | <mgmt> mgmt } | gw2 | <ap> ap",
	    pos="7,0!",
	    requires="infix",
	];

	gw3 [
	    label="{ <mesh> mesh | <mgmt> mgmt } | gw3 | <ap> ap",
	    pos="7,-1!",
	    requires="infix",
	];

	client [
	    label="{ <wifi> wifi | <mgmt> mgmt } | client",
	    pos="8.3,-1!",
	    requires="infix",
	];

	// Two wireless cells, each a medium node the relevant radios join.  The
	// three gw nodes form the 802.11s mesh backhaul on their radio0 (the
	// "mesh" cell); their roaming AP and the client all live on radio1 (the
	// "ap" cell), so the client is in range of every gw's AP and can roam.
	// Communicating radios share an index -> the same cell (see doc/wifi.md):
	//   * physical: maps onto two over-the-air RF cells;
	//   * virtual (qeneth): maps onto two multicast cells the wifimedium
	//     relay bridges mac80211_hwsim frames over.
	mesh [
	    label="mesh backhaul",
	    shape=ellipse,
	    color="cornflowerblue",
	    fontcolor="cornflowerblue",
	    style="dashed",
	    pos="6.73,0.5!",
	    requires="wifi-radio",
	];

	ap [
	    label="client access",
	    shape=ellipse,
	    color="orange",
	    fontcolor="orange",
	    style="dashed",
	    pos="7.3,-0.4!",
	    requires="wifi-radio",
	];

	host:mgmt1 -- gw1:mgmt    [requires="mgmt", color="lightgray"]
	host:mgmt2 -- gw2:mgmt    [requires="mgmt", color="lightgray"]
	host:mgmt3 -- client:mgmt [requires="mgmt", color="lightgray"]
	host:mgmt4 -- gw3:mgmt    [requires="mgmt", color="lightgray"]

	// Wired uplink: the rest of the LAN sits behind gw1.  gw2/gw3 reach it
	// only over the mesh backhaul, so traffic to a client on their APs must
	// cross the mesh.
	host:lan -- gw1:uplink [color="black"]

	// Mesh backhaul (radio0, 5GHz)
	gw1:mesh -- mesh [requires="wifi5GHz", style="dashed"]
	gw2:mesh -- mesh [requires="wifi5GHz", style="dashed"]
	gw3:mesh -- mesh [requires="wifi5GHz", style="dashed"]

	// Roaming AP cell (radio1, 2.4GHz): the gw APs and the client
	gw1:ap -- ap     [requires="wifi2.4GHz", style="dashed", color="orange"]
	gw2:ap -- ap     [requires="wifi2.4GHz", style="dashed", color="orange"]
	gw3:ap -- ap     [requires="wifi2.4GHz", style="dashed", color="orange"]
	client:wifi -- ap [requires="wifi2.4GHz", style="dashed", taillabel=<<table border="0"><tr><td>roams</td><td width="30"></td><td><font point-size="76">⇡</font></td></tr></table>>, labelangle="-80", labeldistance="5.5", color="orange", fontcolor="orange"]
}
