graph "dual_stack" {
	layout="neato";
	overlap="false";
	esep="+20";
	size=10

        node [shape=record, fontname="DejaVu Sans Mono, Book"];
	edge [color="cornflowerblue", penwidth="2", fontname="DejaVu Serif, Book"];

	PC [
	    label="PC | { <mgmt1> mgmt1 | <mgmt2> mgmt2 }",
	    pos="-20,130!",
	    requires="controller",
	];

        R1 [
	    label="{ <mgmt> mgmt | <link> link } | R1 \n router-id 1.1.1.1",
	    pos="160,230!",

	    requires="infix",
	];
	R2 [
	    label="{ <link> link | <mgmt> mgmt } | R2 \n router-id 2.2.2.2",
	    pos="160,30!",

	    requires="infix",
	];

	PC:mgmt1 -- R1:mgmt [requires="mgmt", color="lightgray"]
	PC:mgmt2 -- R2:mgmt [requires="mgmt", color="lightgray"]
	R1:link -- R2:link  [label="192.168.50.0/24\n2001:db8:50::/64", headlabel=".2\n::2", taillabel=".1\n::1", labeldistance=2, fontcolor="black", color="black"]
}
