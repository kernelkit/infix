# Environment for yangerd, see src/yangerd/README.md.  Which optional
# parts run is not set here: yangerd reads what the YANG model carries.
YANGERD_LOG_LEVEL=info

# Soft heap limit, the live data is well under 1 MiB and the rest is
# garbage; without it RSS drifts past 100 MiB on a 512 MiB box and the
# OOM killer picks yangerd during upgrades
GOMEMLIMIT=64MiB
