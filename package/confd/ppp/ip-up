#!/bin/sh
# The default route goes to netd, like DHCP routes, and the peer DNS
# servers to resolvconf.
#    ip-up IFNAME TTY SPEED LOCAL REMOTE IPPARAM

ifname=$1
routes="/etc/net.d/$ifname-ppp.conf"
dns="/run/resolvconf/interfaces/$ifname.conf"

. "/etc/default/pppd-$ifname" 2>/dev/null || exit 0

if [ "$DEFAULT_ROUTE" = 1 ]; then
	next="/run/ppp-$ifname.conf"
	cat > "$next" <<-END
	# Generated by pppd ip-up
	route {
	    prefix = "0.0.0.0/0"
	    nexthop = "$ifname"
	    distance = $ROUTE_PREFERENCE
	    tag = 100
	}
	END
	mv "$next" "$routes"
fi

# pppd only sets these with usepeerdns, i.e., when peer-dns is enabled
if [ -n "$DNS1$DNS2" ]; then
	mkdir -p "$(dirname "$dns")"
	for ns in $DNS1 $DNS2; do
		echo "nameserver $ns # $ifname"
	done > "$dns"
	resolvconf -u
fi
exit 0
