config BR2_PACKAGE_WEBUI
	bool "webui"
	depends on BR2_PACKAGE_HOST_GO_TARGET_ARCH_SUPPORTS
	depends on BR2_PACKAGE_ROUSETTE
	depends on !BR2_PACKAGE_LANDING
	select BR2_PACKAGE_SUPPORT
	help
	  Web management interface for Infix, a Go+HTMX application
	  that provides browser-based configuration and monitoring
	  via RESTCONF.

config BR2_PACKAGE_NETBROWSE
	bool "netbrowse"
	depends on BR2_PACKAGE_WEBUI
	help
	  Browse mDNS hosts on your network from https://network.local

	  The browser is part of webui, this makes it available in the
	  web services configuration.
