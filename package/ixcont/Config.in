config BR2_PACKAGE_IXCONT
	bool "ixcont"
	select BR2_PACKAGE_CRUN
	select BR2_PACKAGE_IPROUTE2
	select BR2_PACKAGE_NFTABLES
	select BR2_PACKAGE_PYTHON3
	select BR2_PACKAGE_PYTHON3_ZLIB
	select BR2_PACKAGE_SKOPEO_TARGET
	help
	  Infix container runtime: runs OCI images with crun directly from
	  the read-only rootfs, supervised by Finit.  Replaces podman.
