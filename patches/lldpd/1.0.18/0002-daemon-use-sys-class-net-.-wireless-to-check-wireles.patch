@@ -388,6 +388,7 @@ static struct dispatch_actions actions[] = { { PRIV_PING, asroot_ping },
 	{ PRIV_GET_HOSTNAME, asroot_gethostname },
 #ifdef HOST_OS_LINUX
 	{ PRIV_OPEN, asroot_open },
