From 4dcf45072ab4f64f57931be55126424668418250 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Mattias=20Walstr=C3=B6m?= <lazzer@gmail.com>
Date: Fri, 11 Sep 2026 08:50:03 +0200
Subject: [PATCH 1/2] hostapd: Do not require the base BSSID to be aligned with
 the BSSID mask
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit
Organization: Wires

hostapd_validate_bssid_configuration() rejected the configuration when
the interface address was not the first address in the block covered by
the generated BSSID mask, i.e., when (addr AND mask) != addr. On systems
where the MAC address of the radio is assigned from outside hostapd
(e.g., derived from a board identifier or set by the network
configuration) that base address cannot be chosen freely, so multi-BSS
setups failed to start even though the driver is able to handle the
resulting address block.

Drop the check and let the driver reject address combinations it cannot
support.

Signed-off-by: Mattias Walström <lazzer@gmail.com>
---
 src/ap/hostapd.c | 12 ------------
 1 file changed, 12 deletions(-)

diff --git a/src/ap/hostapd.c b/src/ap/hostapd.c
index ffa791fd7..fbcd0218b 100644
--- a/src/ap/hostapd.c
+++ b/src/ap/hostapd.c
@@ -984,18 +984,6 @@ skip_mask_ext:
 	if (!auto_addr)
 		return 0;
 
-	for (i = 0; i < ETH_ALEN; i++) {
-		if ((hapd->own_addr[i] & mask[i]) != hapd->own_addr[i]) {
-			wpa_printf(MSG_ERROR, "Invalid BSSID mask " MACSTR
-				   " for start address " MACSTR ".",
-				   MAC2STR(mask), MAC2STR(hapd->own_addr));
-			wpa_printf(MSG_ERROR, "Start address must be the "
-				   "first address in the block (i.e., addr "
-				   "AND mask == addr).");
-			return -1;
-		}
-	}
-
 	return 0;
 }
 
