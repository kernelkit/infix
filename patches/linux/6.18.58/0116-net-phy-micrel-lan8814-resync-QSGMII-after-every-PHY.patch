From d6cd252d4b55a153d4420defa8152940bca00819 Mon Sep 17 00:00:00 2001
From: Joachim Wiberg <troglobit@gmail.com>
Date: Tue, 13 Oct 2026 15:42:34 +0200
Subject: [PATCH 116/128] net: phy: micrel: lan8814: resync QSGMII after every
 PHY reset

On a LAN969x switch with LAN8804 quad PHYs, a copper port can come up
with one direction dead: the switch counts the frames it sends, the link
partner receives none of them, and the link stays up at 1000 Mbps.  A
link flap does not recover it, a QSGMII soft reset of the sending end's
PHY package does.  Taking the interface down and up twice, a few seconds
apart, on both ends of a link triggers it in about one cycle out of five.

The driver resets the QSGMII only at package init, from config_init,
before phylink has configured the MAC side, and phylib soft-resets the
PHY again on every attach.  Microchip's PHY API resets the package
QSGMII and restarts aneg after every PHY reset, once the MAC has
configured its end, and renegotiates each port once more after its first
1000BASE-T link, as a workaround for CRC errors.

Do the same: mark the port in config_init, which runs after each PHY
reset, and do the QSGMII soft reset and an aneg restart in the following
config_aneg, which phylink calls with the MAC side set up.  Restart aneg
once more after the first 1000BASE-T link of each port with both
receivers OK.  With this, the test above passes 20 cycles out of 20.

Signed-off-by: Joachim Wiberg <troglobit@gmail.com>
---
 drivers/net/phy/micrel.c | 58 +++++++++++++++++++++++++++++++++++++++-
 1 file changed, 57 insertions(+), 1 deletion(-)

diff --git a/drivers/net/phy/micrel.c b/drivers/net/phy/micrel.c
index 6aa27b651e81..09d5c5daa2ff 100644
--- a/drivers/net/phy/micrel.c
+++ b/drivers/net/phy/micrel.c
@@ -455,6 +455,8 @@ struct kszphy_priv {
 	bool rmii_ref_clk_sel_val;
 	bool clk_enable;
 	bool is_ptp_available;
+	bool aneg_restarted;
+	bool qsgmii_resync;
 	u64 stats[ARRAY_SIZE(kszphy_hw_stats)];
 	struct kszphy_phy_stats phy_stats;
 };
@@ -4598,9 +4600,62 @@ static int lan8814_config_init(struct phy_device *phydev)
 	if (lan8814->led_mode >= 0)
 		lan8814_setup_led(phydev, lan8814->led_mode);
 
+	lan8814->qsgmii_resync = true;
+
 	return lan8814_erratas(phydev);
 }
 
+/* Microchip's PHY API resets the package QSGMII and restarts aneg after
+ * every PHY reset, once the MAC has configured its end, and renegotiates
+ * each port once after its first 1000BASE-T link, to avoid CRC errors.
+ * Under phylink the MAC side is set up before config_aneg runs.
+ */
+static int lan8814_config_aneg(struct phy_device *phydev)
+{
+	struct kszphy_priv *priv = phydev->priv;
+	bool resync = priv->qsgmii_resync;
+	int err;
+
+	if (resync) {
+		priv->qsgmii_resync = false;
+		err = lanphy_modify_page_reg(phydev, LAN8814_PAGE_COMMON_REGS,
+					     LAN8814_QSGMII_SOFT_RESET,
+					     LAN8814_QSGMII_SOFT_RESET_BIT,
+					     LAN8814_QSGMII_SOFT_RESET_BIT);
+		if (err < 0)
+			return err;
+	}
+
+	err = genphy_config_aneg(phydev);
+	if (err || !resync || phydev->autoneg != AUTONEG_ENABLE)
+		return err;
+
+	return genphy_restart_aneg(phydev);
+}
+
+static int lan8814_read_status(struct phy_device *phydev)
+{
+	struct kszphy_priv *priv = phydev->priv;
+	int err, val;
+
+	err = ksz9031_read_status(phydev);
+	if (err || priv->aneg_restarted || !phydev->link ||
+	    phydev->speed != SPEED_1000)
+		return err;
+
+	val = phy_read(phydev, MII_STAT1000);
+	if (val < 0)
+		return val;
+	if ((val & (LPA_1000LOCALRXOK | LPA_1000REMRXOK)) !=
+	    (LPA_1000LOCALRXOK | LPA_1000REMRXOK))
+		return 0;
+
+	priv->aneg_restarted = true;
+	phydev->link = 0;
+
+	return genphy_restart_aneg(phydev);
+}
+
 /* It is expected that there will not be any 'lan8814_take_coma_mode'
  * function called in suspend. Because the GPIO line can be shared, so if one of
  * the phys goes back in coma mode, then all the other PHYs will go, which is
@@ -6584,7 +6639,8 @@ static struct phy_driver ksphy_driver[] = {
 	.driver_data	= &lan8814_type,
 	.probe		= lan8814_probe,
 	.soft_reset	= genphy_soft_reset,
-	.read_status	= ksz9031_read_status,
+	.config_aneg	= lan8814_config_aneg,
+	.read_status	= lan8814_read_status,
 	.get_sset_count	= kszphy_get_sset_count,
 	.get_strings	= kszphy_get_strings,
 	.get_stats	= kszphy_get_stats,
