@@ -63,8 +63,12 @@ int sparx5_qos_init(struct sparx5 *sparx5);
 int sparx5_tas_init(struct sparx5 *sparx5);
 void sparx5_tas_speed(struct sparx5_port *port, int speed);
 
+int sparx5_tc_prio_tc_set(struct sparx5_port *port, const u8 *prio_tc);
+
 /* Multi-Queue Priority */
-int sparx5_tc_mqprio_add(struct net_device *ndev, u8 num_tc);
+struct tc_mqprio_qopt;
+int sparx5_tc_mqprio_add(struct net_device *ndev,
+			 const struct tc_mqprio_qopt *qopt);
 int sparx5_tc_mqprio_del(struct net_device *ndev);
 
 /* Token Bucket Filter */
diff --git a/drivers/net/ethernet/microchip/sparx5/sparx5_tas.c b/drivers/net/ethernet/microchip/sparx5/sparx5_tas.c
index fbdbec3570a3..67f7b903b4c0 100644
--- a/drivers/net/ethernet/microchip/sparx5/sparx5_tas.c
+++ b/drivers/net/ethernet/microchip/sparx5/sparx5_tas.c
@@ -379,7 +379,7 @@ int sparx5_tc_taprio_add(struct sparx5_port *port,
 
 	sparx5_tas_list_state_set(sparx5, SPX5_TAS_STATE_ADVANCING);
 
-	return 0;
+	return sparx5_tc_prio_tc_set(port, qopt->mqprio.qopt.prio_tc_map);
 }
 
 int sparx5_tc_taprio_del(struct sparx5_port *port)
@@ -390,7 +390,7 @@ int sparx5_tc_taprio_del(struct sparx5_port *port)
 		err = sparx5_tas_list_shutdown(port,
 					       sparx5_tas_list_index(port, i));
 
-	return err;
+	return err ?: sparx5_tc_prio_tc_set(port, NULL);
 }
 
 void sparx5_tas_speed(struct sparx5_port *port, int speed)
diff --git a/drivers/net/ethernet/microchip/sparx5/sparx5_tc.c b/drivers/net/ethernet/microchip/sparx5/sparx5_tc.c
index bb77806817d8..62a0bd40e1e3 100644
--- a/drivers/net/ethernet/microchip/sparx5/sparx5_tc.c
+++ b/drivers/net/ethernet/microchip/sparx5/sparx5_tc.c
@@ -81,7 +81,7 @@ static int sparx5_tc_setup_qdisc_mqprio(struct net_device *ndev,
 	if (m->qopt.num_tc == 0)
 		return sparx5_tc_mqprio_del(ndev);
 	else
-		return sparx5_tc_mqprio_add(ndev, m->qopt.num_tc);
+		return sparx5_tc_mqprio_add(ndev, &m->qopt);
 }
 
 static int sparx5_tc_setup_qdisc_tbf(struct net_device *ndev,
@@ -129,9 +129,6 @@ static int sparx5_tc_setup_qdisc_ets(struct net_device *ndev,
 
 		/* Sanity checks */
 		for (i = 0; i < SPX5_PRIOS; ++i) {
-			/* Priority map is *always* reverse e.g: 7 6 5 .. 0 */
-			if (params->priomap[i] != (7 - i))
-				return -EOPNOTSUPP;
 			/* Throw an error if we receive zero weights by tc */
 			if (params->quanta[i] && params->weights[i] == 0) {
 				pr_err("Invalid ets configuration; band %d has weight zero",
