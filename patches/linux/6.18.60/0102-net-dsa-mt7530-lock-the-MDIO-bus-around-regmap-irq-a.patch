From 496482adbc564614e52b9f8839ae9d644b7702da Mon Sep 17 00:00:00 2001
From: Mattias Walström <lazzer@gmail.com>
Date: Tue, 13 Oct 2026 15:48:00 +0200
Subject: [PATCH 102/139] net: dsa: mt7530: lock the MDIO bus around regmap-irq
 accesses
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit
Organization: Wires

The MDIO register protocol is stateful: a page select followed by two
half word accesses.  The driver's own helpers take bus->mdio_lock
around each sequence and the main regmap is created with locking
disabled, which worked until the interrupt controller was converted to
regmap-irq.  regmap-irq accesses that unlocked regmap directly, from
its thread when reading and acking SYS_INT_STS and from the irq core's
bus lock callbacks when updating SYS_INT_EN, so its page selects
interleave with everybody else's locked sequences.

A locked 32-bit write to a register at the same half word offset on
another page then commits its value into the register the irq thread
just selected.  Seen on a BPI-R3 (MT7531): a link-change interrupt
being acked while the SGMII PCS wrote QPHY_PWR_STATE_CTRL landed that
value in SYS_INT_EN, which went to zero.  From then on every PHY link
change was left pending in SYS_INT_STS, no interrupt ever fired again
and ports that were bounced stayed at no-link although the PHYs had
negotiated, until a reboot.

Give the irq chip a regmap of its own that takes the MDIO bus lock
around every access, the same way the PCS regmaps already do.  The MMIO
backend keeps using its regmap, which has regular locking.

Fixes: 254f6b272e3b ("dsa: mt7530: Utilize REGMAP_IRQ for interrupt handling")
Signed-off-by: Mattias Walström <lazzer@gmail.com>
---
 drivers/net/dsa/mt7530-mdio.c | 25 +++++++++++++++++++++++++
 drivers/net/dsa/mt7530.c      |  3 ++-
 drivers/net/dsa/mt7530.h      |  1 +
 3 files changed, 28 insertions(+), 1 deletion(-)

diff --git a/drivers/net/dsa/mt7530-mdio.c b/drivers/net/dsa/mt7530-mdio.c
index 119fdbea5716..749d74632936 100644
--- a/drivers/net/dsa/mt7530-mdio.c
+++ b/drivers/net/dsa/mt7530-mdio.c
@@ -154,6 +154,7 @@ static const struct regmap_config regmap_config = {
 static int
 mt7530_probe(struct mdio_device *mdiodev)
 {
+	struct regmap_config *irq_config;
 	struct mt7530_priv *priv;
 	struct device_node *dn;
 	int ret;
@@ -212,6 +213,30 @@ mt7530_probe(struct mdio_device *mdiodev)
 	if (IS_ERR(priv->regmap))
 		return PTR_ERR(priv->regmap);
 
+	/* regmap-irq accesses the switch from its own thread and from the
+	 * irq core's bus lock callbacks, outside the driver's MDIO locking.
+	 * The register protocol is stateful, a page select followed by two
+	 * half words, so an unlocked access interleaving with a locked one
+	 * commits the latter's value into whatever register the former
+	 * selected.  Give the irq chip a regmap that takes the MDIO bus lock
+	 * around every access, like the PCS regmaps do.
+	 */
+	irq_config = devm_kmemdup(priv->dev, &regmap_config,
+				  sizeof(regmap_config), GFP_KERNEL);
+	if (!irq_config)
+		return -ENOMEM;
+
+	irq_config->name = "irq";
+	irq_config->disable_locking = false;
+	irq_config->lock = mt7530_mdio_regmap_lock;
+	irq_config->unlock = mt7530_mdio_regmap_unlock;
+	irq_config->lock_arg = &priv->bus->mdio_lock;
+
+	priv->irq_regmap = devm_regmap_init(priv->dev, &mt7530_regmap_bus,
+					    priv, irq_config);
+	if (IS_ERR(priv->irq_regmap))
+		return PTR_ERR(priv->irq_regmap);
+
 	if (priv->id == ID_MT7531)
 		priv->create_sgmii = mt7531_create_sgmii;
 
diff --git a/drivers/net/dsa/mt7530.c b/drivers/net/dsa/mt7530.c
index bd0a37ead0de..9e06b79e64e8 100644
--- a/drivers/net/dsa/mt7530.c
+++ b/drivers/net/dsa/mt7530.c
@@ -2309,7 +2309,8 @@ mt7530_setup_irq(struct mt7530_priv *priv)
 		mt7530_set(priv, MT7530_TOP_SIG_CTRL, TOP_SIG_CTRL_NORMAL);
 
 	ret = devm_regmap_add_irq_chip_fwnode(dev, dev_fwnode(dev),
-					      priv->regmap, irq,
+					      priv->irq_regmap ?: priv->regmap,
+					      irq,
 					      IRQF_ONESHOT,
 					      0, &mt7530_regmap_irq_chip,
 					      &irq_data);
diff --git a/drivers/net/dsa/mt7530.h b/drivers/net/dsa/mt7530.h
index ca665f87f1f6..760c3d9e878e 100644
--- a/drivers/net/dsa/mt7530.h
+++ b/drivers/net/dsa/mt7530.h
@@ -887,6 +887,7 @@ struct mt7530_priv {
 	struct dsa_switch	*ds;
 	struct mii_bus		*bus;
 	struct regmap		*regmap;
+	struct regmap		*irq_regmap;
 	struct reset_control	*rstc;
 	struct regulator	*core_pwr;
 	struct regulator	*io_pwr;
