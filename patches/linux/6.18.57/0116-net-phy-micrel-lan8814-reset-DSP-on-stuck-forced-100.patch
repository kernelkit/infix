From e998dce56dc895e6418d10e16bf65c0600816564 Mon Sep 17 00:00:00 2001
From: Joachim Wiberg <troglobit@gmail.com>
Date: Tue, 13 Oct 2026 16:42:51 +0200
Subject: [PATCH 116/125] net: phy: micrel: lan8814: reset DSP on stuck forced
 100BASE-TX

With the speed forced to 100 Mbps, the LAN8814 DSP can fail to train on
the received signal, and the link never comes up (errata module 22).
The errata calls for periodic poll and restart.

Extend the autonegotiation watchdog: with autonegotiation off at 100
Mbps, soft reset the DSP every three seconds while the PHY detects a
link partner but has no link, as Microchip's PHY API does.  The soft
reset keeps the register settings.

Signed-off-by: Joachim Wiberg <troglobit@gmail.com>
---
 drivers/net/phy/micrel.c | 115 ++++++++++++++++++++++++++-------------
 1 file changed, 77 insertions(+), 38 deletions(-)

diff --git a/drivers/net/phy/micrel.c b/drivers/net/phy/micrel.c
index 969d4590978d..af358c30cd75 100644
--- a/drivers/net/phy/micrel.c
+++ b/drivers/net/phy/micrel.c
@@ -460,8 +460,8 @@ struct kszphy_priv {
 	bool is_ptp_available;
 	bool aneg_restarted;
 	struct phy_device *phydev;
-	struct delayed_work aneg_work;
-	unsigned int aneg_checks;
+	struct delayed_work link_work;
+	unsigned int link_checks;
 	bool link_up;
 	u64 stats[ARRAY_SIZE(kszphy_hw_stats)];
 	struct kszphy_phy_stats phy_stats;
@@ -4622,66 +4622,105 @@ static int lan8814_config_init(struct phy_device *phydev)
 }
 
 #define LAN8814_AX_AN_STATUS			0x14
+#define LAN8814_AX_AN_STATUS_LINK_DET		BIT(14)
 #define LAN8814_AX_AN_STATUS_SIG_DET		BIT(13)
-#define LAN8814_ANEG_CHECKS			3
+#define LAN8814_CTRL_SOFT_RESET			BIT(1)
+#define LAN8814_LINK_CHECKS			3
 
-static void lan8814_aneg_queue(struct kszphy_priv *priv, unsigned int secs)
+static void lan8814_link_queue(struct kszphy_priv *priv, unsigned int secs)
 {
-	mod_delayed_work(system_power_efficient_wq, &priv->aneg_work,
+	mod_delayed_work(system_power_efficient_wq, &priv->link_work,
 			 round_jiffies_relative(secs * HZ));
 }
 
-/* Errata module 20: autonegotiation can get stuck while the link partner is
- * present.  Restart it once if a signal has been detected for three seconds
- * without a link, as Microchip's PHY API does.
+/* Count the seconds the PHY reports @det in LAN8814_AX_AN_STATUS while BMSR
+ * shows none of @bmsr, and return true once that reaches LAN8814_LINK_CHECKS.
  */
-static void lan8814_aneg_work(struct work_struct *work)
+static bool lan8814_link_stuck(struct phy_device *phydev, u16 det, u16 bmsr)
 {
-	struct kszphy_priv *priv = container_of(work, struct kszphy_priv,
-						aneg_work.work);
-	struct phy_device *phydev = priv->phydev;
+	struct kszphy_priv *priv = phydev->priv;
 	int val;
 
-	mutex_lock(&phydev->lock);
-
-	if (!phy_is_started(phydev) || phydev->link ||
-	    phydev->autoneg != AUTONEG_ENABLE)
-		goto out;
-
 	val = phy_read(phydev, LAN8814_AX_AN_STATUS);
 	if (val < 0)
-		goto out;
+		return false;
 
-	if (!(val & LAN8814_AX_AN_STATUS_SIG_DET)) {
-		priv->aneg_checks = 0;
-		lan8814_aneg_queue(priv, 5);
-		goto out;
+	if (!(val & det)) {
+		priv->link_checks = 0;
+		lan8814_link_queue(priv, 5);
+		return false;
 	}
 
 	val = phy_read(phydev, MII_BMSR);
-	if (val < 0 || (val & (BMSR_LSTATUS | BMSR_ANEGCOMPLETE)))
-		goto out;
+	if (val < 0 || (val & bmsr))
+		return false;
 
-	if (++priv->aneg_checks < LAN8814_ANEG_CHECKS) {
-		lan8814_aneg_queue(priv, 1);
-		goto out;
+	if (++priv->link_checks < LAN8814_LINK_CHECKS) {
+		lan8814_link_queue(priv, 1);
+		return false;
 	}
 
+	priv->link_checks = 0;
+	return true;
+}
+
+/* Errata module 20: autonegotiation can get stuck while the link partner is
+ * present.  Restart it once if a signal has been detected for three seconds
+ * without a link, as Microchip's PHY API does.
+ */
+static void lan8814_aneg_check(struct phy_device *phydev)
+{
+	if (!lan8814_link_stuck(phydev, LAN8814_AX_AN_STATUS_SIG_DET,
+				BMSR_LSTATUS | BMSR_ANEGCOMPLETE))
+		return;
+
 	phydev_dbg(phydev, "autonegotiation stuck, restarting\n");
 	genphy_restart_aneg(phydev);
-out:
+}
+
+/* Errata module 22: a forced 100BASE-TX link can fail to train.  Soft reset
+ * the DSP every three seconds while the PHY detects a link partner but has
+ * no link, as Microchip's PHY API does.
+ */
+static void lan8814_100tx_check(struct phy_device *phydev)
+{
+	if (!lan8814_link_stuck(phydev, LAN8814_AX_AN_STATUS_LINK_DET,
+				BMSR_LSTATUS))
+		return;
+
+	phydev_dbg(phydev, "no 100BASE-TX link, resetting DSP\n");
+	phy_set_bits(phydev, MII_KSZPHY_CTRL, LAN8814_CTRL_SOFT_RESET);
+	lan8814_link_queue(phydev->priv, 1);
+}
+
+static void lan8814_link_work(struct work_struct *work)
+{
+	struct kszphy_priv *priv = container_of(work, struct kszphy_priv,
+						link_work.work);
+	struct phy_device *phydev = priv->phydev;
+
+	mutex_lock(&phydev->lock);
+
+	if (phy_is_started(phydev) && !phydev->link) {
+		if (phydev->autoneg == AUTONEG_ENABLE)
+			lan8814_aneg_check(phydev);
+		else if (phydev->speed == SPEED_100)
+			lan8814_100tx_check(phydev);
+	}
+
 	mutex_unlock(&phydev->lock);
 }
 
-static void lan8814_aneg_arm(struct phy_device *phydev)
+static void lan8814_link_watch(struct phy_device *phydev)
 {
 	struct kszphy_priv *priv = phydev->priv;
 
-	priv->aneg_checks = 0;
-	if (phydev->link || phydev->autoneg != AUTONEG_ENABLE)
-		cancel_delayed_work(&priv->aneg_work);
+	priv->link_checks = 0;
+	if (phydev->link || (phydev->autoneg != AUTONEG_ENABLE &&
+			     phydev->speed != SPEED_100))
+		cancel_delayed_work(&priv->link_work);
 	else
-		lan8814_aneg_queue(priv, 1);
+		lan8814_link_queue(priv, 1);
 }
 
 #define LAN8814_RX_RA_FIFO_THRESHOLDS_1		0x20
@@ -4725,7 +4764,7 @@ static void lan8814_link_change_notify(struct phy_device *phydev)
 					      ARRAY_SIZE(half_duplex_errata));
 	}
 
-	lan8814_aneg_arm(phydev);
+	lan8814_link_watch(phydev);
 }
 
 /* Microchip's PHY API resets the package QSGMII once the MAC has configured
@@ -4747,7 +4786,7 @@ static int lan8814_config_aneg(struct phy_device *phydev)
 			return err;
 	}
 
-	lan8814_aneg_arm(phydev);
+	lan8814_link_watch(phydev);
 
 	return genphy_config_aneg(phydev);
 }
@@ -4876,7 +4915,7 @@ static int lan8814_probe(struct phy_device *phydev)
 	phy_disable_eee(phydev);
 
 	priv->phydev = phydev;
-	INIT_DELAYED_WORK(&priv->aneg_work, lan8814_aneg_work);
+	INIT_DELAYED_WORK(&priv->link_work, lan8814_link_work);
 
 	return 0;
 }
@@ -4885,7 +4924,7 @@ static void lan8814_remove(struct phy_device *phydev)
 {
 	struct kszphy_priv *priv = phydev->priv;
 
-	cancel_delayed_work_sync(&priv->aneg_work);
+	cancel_delayed_work_sync(&priv->link_work);
 }
 
 #define LAN8841_MMD_TIMER_REG			0
