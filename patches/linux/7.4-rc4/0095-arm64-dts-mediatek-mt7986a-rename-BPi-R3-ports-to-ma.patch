From a05c126b669cc21590f9074e6e67b538f9b3c925 Mon Sep 17 00:00:00 2001
From: Joachim Wiberg <troglobit@gmail.com>
Date: Sun, 10 Aug 2025 18:52:54 +0200
Subject: [PATCH 095/124] arm64: dts: mediatek: mt7986a: rename BPi R3 ports to
 match case
Organization: Wires

For ref. see: https://wiki.banana-pi.org/File:Bpi-r3_Metal_case.jpg

Also, comment out gpio-keys (reset and wps) since they clash with with
the PCIe controller.

Signed-off-by: Joachim Wiberg <troglobit@gmail.com>
---
 .../boot/dts/mediatek/mt7986a-bananapi-bpi-r3.dts  | 14 +++++++-------
 1 file changed, 7 insertions(+), 7 deletions(-)

diff --git a/arch/arm64/boot/dts/mediatek/mt7986a-bananapi-bpi-r3.dts b/arch/arm64/boot/dts/mediatek/mt7986a-bananapi-bpi-r3.dts
index 70c693fd0c52..3fe73261f5d6 100644
--- a/arch/arm64/boot/dts/mediatek/mt7986a-bananapi-bpi-r3.dts
+++ b/arch/arm64/boot/dts/mediatek/mt7986a-bananapi-bpi-r3.dts
@@ -48,7 +48,7 @@ fan: pwm-fan {
 		pwms = <&pwm 0 10000>;
 		status = "okay";
 	};
-
+/*
 	gpio-keys {
 		compatible = "gpio-keys";
 
@@ -64,7 +64,7 @@ wps-key {
 			gpios = <&pio 10 GPIO_ACTIVE_LOW>;
 		};
 	};
-
+*/
 	/* i2c of the left SFP cage (wan) */
 	i2c_sfp1: i2c-0 {
 		compatible = "i2c-gpio";
@@ -430,27 +430,27 @@ port@0 {
 
 		port@1 {
 			reg = <1>;
-			label = "lan0";
+			label = "lan1";
 		};
 
 		port@2 {
 			reg = <2>;
-			label = "lan1";
+			label = "lan2";
 		};
 
 		port@3 {
 			reg = <3>;
-			label = "lan2";
+			label = "lan3";
 		};
 
 		port@4 {
 			reg = <4>;
-			label = "lan3";
+			label = "lan4";
 		};
 
 		port5: port@5 {
 			reg = <5>;
-			label = "lan4";
+			label = "sfp2";
 			phy-mode = "2500base-x";
 			sfp = <&sfp2>;
 			managed = "in-band-status";
