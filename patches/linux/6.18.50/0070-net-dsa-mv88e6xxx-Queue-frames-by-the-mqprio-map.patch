+/* Queue each priority in the first queue of its traffic class, or in the
+ * queue of the same number when no map is installed.
+ */
+static int mv88e6xxx_port_set_qpri(struct mv88e6xxx_chip *chip, int port,
+				   struct tc_mqprio_qopt *qopt)
+{
+	u8 *qpri = chip->ports[port].qpri;
+	int prio, err = 0;
+
+	for (prio = 0; prio < ARRAY_SIZE(chip->ports[port].qpri); prio++) {
+		if (qopt)
+			qpri[prio] = min_t(u8, qopt->offset[qopt->prio_tc_map[prio]], 7);
+		else
+			qpri[prio] = prio;
+	}
+
+	if (!chip->info->ops->port_sync_qpri)
+		return 0;
+
+	mv88e6xxx_reg_lock(chip);
+	err = chip->info->ops->port_sync_qpri(chip, port);
+	mv88e6xxx_reg_unlock(chip);
+
+	return err;
+}
+
 static int mv88e6xxx_qos_port_mqprio(struct mv88e6xxx_chip *chip, int port,
 				     struct tc_mqprio_qopt_offload *mqprio)
 {
@@ -7577,10 +7613,11 @@ static int mv88e6xxx_qos_port_mqprio(struct mv88e6xxx_chip *chip, int port,
 	if (err)
 		goto out_reset;
 
-	return 0;
+	return mv88e6xxx_port_set_qpri(chip, port, qopt);
 
 out_reset:
 	netdev_reset_tc(dev);
+	mv88e6xxx_port_set_qpri(chip, port, NULL);
 	return err;
 
 }
