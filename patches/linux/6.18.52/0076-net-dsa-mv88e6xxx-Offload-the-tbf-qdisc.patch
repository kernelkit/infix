 		return mv88e6xxx_qos_query_caps(type_data);
 	case TC_SETUP_QDISC_MQPRIO:
 		return mv88e6xxx_qos_port_mqprio(chip, port, type_data);
+	case TC_SETUP_QDISC_TBF:
+		return mv88e6xxx_qos_port_tbf(chip, port, type_data);
 	default:
 		return -EOPNOTSUPP;
 	}
