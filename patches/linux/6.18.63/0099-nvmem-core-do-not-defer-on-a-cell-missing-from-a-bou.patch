From 7f848c92052fc0fe92fe14aa731b7304ed02e394 Mon Sep 17 00:00:00 2001
From: Mattias Walström <lazzer@gmail.com>
Date: Tue, 13 Oct 2026 10:52:54 +0200
Subject: [PATCH 099/138] nvmem: core: do not defer on a cell missing from a
 bound layout
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

A layout adds all of its cells from its probe, so once it is bound a
missing cell will never show up.  Return -ENOENT instead of deferring
forever, e.g. an ONIE TLV layout over an unprovisioned partition must
not keep the Ethernet driver from probing.

Signed-off-by: Mattias Walström <lazzer@gmail.com>
---
 drivers/nvmem/core.c | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/drivers/nvmem/core.c b/drivers/nvmem/core.c
index 4b1754d89b7a..516e2dbb211b 100644
--- a/drivers/nvmem/core.c
+++ b/drivers/nvmem/core.c
@@ -1453,7 +1453,11 @@ struct nvmem_cell *of_nvmem_cell_get(struct device_node *np, const char *id)
 	of_node_put(cell_np);
 	if (!cell_entry) {
 		nvmem_layout_module_put(nvmem);
-		ret = nvmem->layout ? -EPROBE_DEFER : -ENOENT;
+		/* A bound layout has added all its cells, the cell is not there */
+		if (nvmem->layout && !device_is_bound(&nvmem->layout->dev))
+			ret = -EPROBE_DEFER;
+		else
+			ret = -ENOENT;
 		__nvmem_device_put(nvmem);
 		return ERR_PTR(ret);
 	}
