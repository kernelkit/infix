@@ -90,6 +90,7 @@ const unsigned int lan969x_gaddr[GADDR_LAST] = {
 	[GA_EACL_ES2_STICKY] = 29072,
 	[GA_EACL_RAM_CTRL] = 29112,
 	[GA_GCB_SIO_CTRL] = 560,
+	[GA_HSCH_HSCH_L0_CFG] = 40960,
 	[GA_HSCH_HSCH_DWRR] = 36480,
 	[GA_HSCH_HSCH_MISC] = 36608,
 	[GA_HSCH_HSCH_LEAK_LISTS] = 37256,
@@ -129,6 +130,7 @@ const unsigned int lan969x_gcnt[GCNT_LAST] = {
 	[GC_EACL_ES2_KEY_SELECT_PROFILE] = 68,
 	[GC_EACL_CNT_TBL] = 512,
 	[GC_GCB_SIO_CTRL] = 1,
+	[GC_HSCH_HSCH_L0_CFG] = 1120,
 	[GC_HSCH_HSCH_CFG] = 1120,
 	[GC_HSCH_HSCH_DWRR] = 32,
 	[GC_HSCH_TAS_PROFILE_CFG] = 30,
@@ -195,6 +197,8 @@ const unsigned int lan969x_fsize[FSIZE_LAST] = {
 	[FW_ANA_L3_VLAN_MASK_CFG_VLAN_PORT_MASK] = 30,
 	[FW_FDMA_CH_CFG_CH_DCB_DB_CNT] = 2,
 	[FW_GCB_HW_SGPIO_TO_SD_MAP_CFG_SGPIO_TO_SD_SEL] = 7,
+	[FW_HSCH_HSCH_L0_CFG_NEXT_IDX] = 6,
+	[FW_HSCH_HSCH_L0_CFG_NEXT_INP] = 4,
 	[FW_HSCH_SE_CFG_SE_DWRR_CNT] = 5,
 	[FW_HSCH_SE_CONNECT_SE_LEAK_LINK] = 14,
 	[FW_HSCH_SE_DLB_SENSE_SE_DLB_DPORT] = 6,
diff --git a/drivers/net/ethernet/microchip/sparx5/sparx5_main_regs.h b/drivers/net/ethernet/microchip/sparx5/sparx5_main_regs.h
index 1a3954e5df9a..40eebd7dd1a6 100644
--- a/drivers/net/ethernet/microchip/sparx5/sparx5_main_regs.h
+++ b/drivers/net/ethernet/microchip/sparx5/sparx5_main_regs.h
@@ -5187,6 +5187,37 @@ extern const struct sparx5_regs *regs;
 #define GCB_SIO_CLOCK_SYS_CLK_PERIOD_GET(x)\
 	FIELD_GET(GCB_SIO_CLOCK_SYS_CLK_PERIOD, x)
 
+/* HSCH:HSCH_L0_CFG:HSCH_L0_CFG */
+#define HSCH_HSCH_L0_CFG(g)                                                    \
+	__REG(TARGET_HSCH, 0, 1, regs->gaddr[GA_HSCH_HSCH_L0_CFG], g,          \
+	      regs->gcnt[GC_HSCH_HSCH_L0_CFG], 4, 0, 0, 1, 4)
+
+#define HSCH_HSCH_L0_CFG_NEXT_LAYER              BIT(21)
+#define HSCH_HSCH_L0_CFG_NEXT_LAYER_SET(x)\
+	FIELD_PREP(HSCH_HSCH_L0_CFG_NEXT_LAYER, x)
+#define HSCH_HSCH_L0_CFG_NEXT_LAYER_GET(x)\
+	FIELD_GET(HSCH_HSCH_L0_CFG_NEXT_LAYER, x)
+
+#define HSCH_HSCH_L0_CFG_NEXT_IDX\
+	GENMASK(regs->fsize[FW_HSCH_HSCH_L0_CFG_NEXT_IDX] + 14 - 1, 14)
+#define HSCH_HSCH_L0_CFG_NEXT_IDX_SET(x)\
+	spx5_field_prep(HSCH_HSCH_L0_CFG_NEXT_IDX, x)
+#define HSCH_HSCH_L0_CFG_NEXT_IDX_GET(x)\
+	spx5_field_get(HSCH_HSCH_L0_CFG_NEXT_IDX, x)
+
+#define HSCH_HSCH_L0_CFG_NEXT_INP\
+	GENMASK(regs->fsize[FW_HSCH_HSCH_L0_CFG_NEXT_INP] + 8 - 1, 8)
+#define HSCH_HSCH_L0_CFG_NEXT_INP_SET(x)\
+	spx5_field_prep(HSCH_HSCH_L0_CFG_NEXT_INP, x)
+#define HSCH_HSCH_L0_CFG_NEXT_INP_GET(x)\
+	spx5_field_get(HSCH_HSCH_L0_CFG_NEXT_INP, x)
+
+#define HSCH_HSCH_L0_CFG_P_QUEUES                GENMASK(7, 0)
+#define HSCH_HSCH_L0_CFG_P_QUEUES_SET(x)\
+	FIELD_PREP(HSCH_HSCH_L0_CFG_P_QUEUES, x)
+#define HSCH_HSCH_L0_CFG_P_QUEUES_GET(x)\
+	FIELD_GET(HSCH_HSCH_L0_CFG_P_QUEUES, x)
+
 /* HSCH:HSCH_CFG:CIR_CFG */
 #define HSCH_CIR_CFG(g)                                                        \
 	__REG(TARGET_HSCH, 0, 1, 0, g, regs->gcnt[GC_HSCH_HSCH_CFG], 32, 0, 0, \
diff --git a/drivers/net/ethernet/microchip/sparx5/sparx5_qos.c b/drivers/net/ethernet/microchip/sparx5/sparx5_qos.c
index 14331f1a0c57..a38c98bdc4e7 100644
--- a/drivers/net/ethernet/microchip/sparx5/sparx5_qos.c
+++ b/drivers/net/ethernet/microchip/sparx5/sparx5_qos.c
@@ -386,24 +386,51 @@ static u32 sparx5_weight_to_hw_cost(u32 weight_min, u32 weight)
 static int sparx5_dwrr_conf_set(struct sparx5_port *port,
 				struct sparx5_dwrr *dwrr)
 {
-	u32 layer = is_sparx5(port->sparx5) ? 2 : 1;
-	int i;
+	struct sparx5 *sparx5 = port->sparx5;
+	u32 val, first = 0, top = 0, l0, idx;
+	u8 inp[SPX5_PRIOS];
+	int q;
 
-	spx5_rmw(HSCH_HSCH_CFG_CFG_HSCH_LAYER_SET(layer) |
-		 HSCH_HSCH_CFG_CFG_CFG_SE_IDX_SET(port->portno),
+	/* The chip builds the hierarchy, so read where the queues go: one
+	 * element, which serves its inputs 0 to SE_DWRR_CNT weighted and
+	 * the rest strict, so the strict queues must sit above there too.
+	 */
+	for (q = 0; q < SPX5_PRIOS; q++) {
+		l0 = sparx5_hsch_l0_get_idx(sparx5, port->portno, q);
+		val = spx5_rd(sparx5, HSCH_HSCH_L0_CFG(l0));
+		if (q == 0) {
+			first = val;
+		} else if ((val ^ first) & (HSCH_HSCH_L0_CFG_NEXT_LAYER |
+					    HSCH_HSCH_L0_CFG_NEXT_IDX)) {
+			netdev_warn(port->ndev,
+				    "the queues are not scheduled by one element\n");
+			return -EOPNOTSUPP;
+		}
+		inp[q] = HSCH_HSCH_L0_CFG_NEXT_INP_GET(val);
+		if (q < dwrr->count) {
+			top = max_t(u32, top, inp[q]);
+		} else if (dwrr->count && inp[q] <= top) {
+			netdev_warn(port->ndev,
+				    "queue %d is scheduled below a weighted one\n",
+				    q);
+			return -EOPNOTSUPP;
+		}
+	}
+	idx = HSCH_HSCH_L0_CFG_NEXT_IDX_GET(first);
+
+	spx5_rmw(HSCH_HSCH_CFG_CFG_HSCH_LAYER_SET(
+			 HSCH_HSCH_L0_CFG_NEXT_LAYER_GET(first) ? 2 : 1) |
+		 HSCH_HSCH_CFG_CFG_CFG_SE_IDX_SET(idx),
 		 HSCH_HSCH_CFG_CFG_HSCH_LAYER | HSCH_HSCH_CFG_CFG_CFG_SE_IDX,
-		 port->sparx5, HSCH_HSCH_CFG_CFG);
+		 sparx5, HSCH_HSCH_CFG_CFG);
 
-	/* Number of *lower* indexes that are arbitrated dwrr */
-	spx5_rmw(HSCH_SE_CFG_SE_DWRR_CNT_SET(dwrr->count),
-		 HSCH_SE_CFG_SE_DWRR_CNT, port->sparx5,
-		 HSCH_SE_CFG(port->portno));
+	spx5_rmw(HSCH_SE_CFG_SE_DWRR_CNT_SET(top), HSCH_SE_CFG_SE_DWRR_CNT,
+		 sparx5, HSCH_SE_CFG(idx));
 
-	for (i = 0; i < dwrr->count; i++) {
-		spx5_rmw(HSCH_DWRR_ENTRY_DWRR_COST_SET(dwrr->cost[i]),
-			 HSCH_DWRR_ENTRY_DWRR_COST, port->sparx5,
-			 HSCH_DWRR_ENTRY(i));
-	}
+	for (q = 0; q < dwrr->count; q++)
+		spx5_rmw(HSCH_DWRR_ENTRY_DWRR_COST_SET(dwrr->cost[q]),
+			 HSCH_DWRR_ENTRY_DWRR_COST, sparx5,
+			 HSCH_DWRR_ENTRY(inp[q]));
 
 	return 0;
 }
diff --git a/drivers/net/ethernet/microchip/sparx5/sparx5_qos.h b/drivers/net/ethernet/microchip/sparx5/sparx5_qos.h
index 2aae77d23d11..0f47b4ac1560 100644
--- a/drivers/net/ethernet/microchip/sparx5/sparx5_qos.h
+++ b/drivers/net/ethernet/microchip/sparx5/sparx5_qos.h
@@ -55,8 +55,8 @@ struct sparx5_layer {
 };
 
 struct sparx5_dwrr {
-	u32 count; /* Number of inputs running dwrr */
-	u8 cost[SPX5_PRIOS];
+	u32 count; /* Queues 0 to count - 1 are weighted, the rest strict */
+	u8 cost[SPX5_PRIOS]; /* Per queue */
 };
 
 int sparx5_qos_init(struct sparx5 *sparx5);
