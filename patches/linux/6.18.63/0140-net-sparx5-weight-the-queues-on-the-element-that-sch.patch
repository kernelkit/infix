 .../microchip/sparx5/sparx5_main_regs.h       | 31 +++++++++++
 .../ethernet/microchip/sparx5/sparx5_qos.c    | 55 ++++++++++++++-----
 .../ethernet/microchip/sparx5/sparx5_qos.h    |  4 +-
 .../ethernet/microchip/sparx5/sparx5_regs.c   |  4 ++
 .../ethernet/microchip/sparx5/sparx5_regs.h   |  4 ++
 6 files changed, 86 insertions(+), 16 deletions(-)

