+void sparx5_set_port_ifh_qos_class(void *ifh_hdr, u8 qos_class)
+{
+	/* VSTAX.CL_QOS = the priority, queued by the destination port's map */
+	ifh_encode_bitfield(ifh_hdr, qos_class, VSTAX + 56, 3);
+}
