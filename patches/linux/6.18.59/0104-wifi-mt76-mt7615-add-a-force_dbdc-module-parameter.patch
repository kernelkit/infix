From bdea9c3e1271379a2643f474727856061590b68d Mon Sep 17 00:00:00 2001
From: Joachim Wiberg <troglobit@gmail.com>
Date: Sun, 18 Oct 2026 13:47:49 +0200
Subject: [PATCH 104/125] wifi: mt76: mt7615: add a force_dbdc module parameter

An MT7615D card with an unprogrammed EEPROM selects no band, so the
driver registers one radio that runs on either 2.4 or 5 GHz instead of
one radio per band:

  $ ls /sys/class/ieee80211/
  phy0

The driver cannot tell an MT7615D from an MT7615N, which has only one
radio.  Add a force_dbdc module parameter to run both bands concurrently
when the EEPROM selects no band.

Signed-off-by: Joachim Wiberg <troglobit@gmail.com>
---
 drivers/net/wireless/mediatek/mt76/mt7615/eeprom.c | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/drivers/net/wireless/mediatek/mt76/mt7615/eeprom.c b/drivers/net/wireless/mediatek/mt76/mt7615/eeprom.c
index d4bc7e11e772..638578e07329 100644
--- a/drivers/net/wireless/mediatek/mt76/mt7615/eeprom.c
+++ b/drivers/net/wireless/mediatek/mt76/mt7615/eeprom.c
@@ -98,6 +98,10 @@ static int mt7615_check_eeprom(struct mt76_dev *dev)
 	}
 }
 
+static bool force_dbdc;
+module_param(force_dbdc, bool, 0444);
+MODULE_PARM_DESC(force_dbdc, "Use both bands concurrently (DBDC) when the EEPROM does not select a band");
+
 static void
 mt7615_eeprom_parse_hw_band_cap(struct mt7615_dev *dev)
 {
@@ -136,6 +140,11 @@ mt7615_eeprom_parse_hw_band_cap(struct mt7615_dev *dev)
 		break;
 	default:
 		dev->mphy.cap.has_2ghz = true;
+		if (force_dbdc) {
+			dev_info(dev->mt76.dev, "no band selected in EEPROM, forcing DBDC\n");
+			dev->dbdc_support = true;
+			break;
+		}
 		dev->mphy.cap.has_5ghz = true;
 		break;
 	}
