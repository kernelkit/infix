From 3a4eb22eab16fbbe69fd5975c5bac14968f37af1 Mon Sep 17 00:00:00 2001
From: Joachim Wiberg <troglobit@gmail.com>
Date: Sat, 24 Oct 2026 20:25:58 +0200
Subject: [PATCH 108/132] usb: probe EHCI, OHCI platform controllers
 synchronously

On SoCs with more than one EHCI/OHCI pair, e.g. RK3568, asynchronous
probing lets the controllers register in a different order each boot,
so USB bus numbers, and with them port names like 2-1, change between
boots.  Userspace that anchors a device to its USB port, e.g. a modem
in a Mini PCIe slot, then points at the wrong device.

This reverts commit 69a1c9a9b273 ("usb: Probe EHCI, OHCI controllers
asynchronously").

Signed-off-by: Joachim Wiberg <troglobit@gmail.com>
---
 drivers/usb/host/ehci-platform.c | 1 -
 drivers/usb/host/ohci-platform.c | 1 -
 2 files changed, 2 deletions(-)

diff --git a/drivers/usb/host/ehci-platform.c b/drivers/usb/host/ehci-platform.c
index 6aab45c8525c..36b3be36a443 100644
--- a/drivers/usb/host/ehci-platform.c
+++ b/drivers/usb/host/ehci-platform.c
@@ -516,7 +516,6 @@ static struct platform_driver ehci_platform_driver = {
 		.pm	= pm_ptr(&ehci_platform_pm_ops),
 		.of_match_table = vt8500_ehci_ids,
 		.acpi_match_table = ACPI_PTR(ehci_acpi_match),
-		.probe_type = PROBE_PREFER_ASYNCHRONOUS,
 	}
 };
 
diff --git a/drivers/usb/host/ohci-platform.c b/drivers/usb/host/ohci-platform.c
index 059621210d2c..57f472ab3864 100644
--- a/drivers/usb/host/ohci-platform.c
+++ b/drivers/usb/host/ohci-platform.c
@@ -352,7 +352,6 @@ static struct platform_driver ohci_platform_driver = {
 		.pm	= &ohci_platform_pm_ops,
 #endif
 		.of_match_table = ohci_platform_ids,
-		.probe_type = PROBE_PREFER_ASYNCHRONOUS,
 	}
 };
 
