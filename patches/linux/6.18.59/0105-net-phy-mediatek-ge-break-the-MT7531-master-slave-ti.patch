From d4dd4677963fcf33c72661ccdb260d490a9868ef Mon Sep 17 00:00:00 2001
From: Mattias Walström <lazzer@gmail.com>
Date: Wed, 14 Oct 2026 19:56:12 +0200
Subject: [PATCH 105/109] net: phy: mediatek-ge: break the MT7531 master/slave
 tie after a resume

Two MT7531 PHYs connected back to back fail to link up again when both
are powered down and resumed at the same time, which is what happens
when a management system bounces both ends of a link.  Both ends then
sit with autonegotiation enabled and never completing, the 1000BASE-T
status register shows both resolved as master and eventually the
master/slave configuration fault bit, and the exchange repeats forever.
Measured on a BPI-R3 pair with synchronized ip link bounces, the link
either comes up after 3.0 s or never: 3 of 10 never, with the status
register cycling 0x4000, 0x0800, 0x4800, 0x8800 for as long as one
cares to watch.

The PHY draws the same master/slave seed on every attempt after it
leaves BMCR power-down, so two PHYs leaving it together keep drawing
the same seed.  No register exposes the seed.  Keeping the PHY out of
power-down is not an option either: the switch is not reset by a warm
reset of the SoC and firmware only clears power-down, so any other
quiet state survives a crash into the bootloader, and a PHY left in
loopback there echoes every frame back into the switch and breaks
netboot until a cold boot.

A plain autonegotiation restart on one end does not reliably break the
tie, a power-down pulse on one end does.  So watch each resume: when
the port has received pages from its partner but has no link after the
normal link-up time, pulse power-down, at a moment derived from the
port's MAC address so that the two ends never pulse together.  A port
with nobody on the other end is left alone.

With this in place the same pair went through 1000 synchronized
bounces: 356 of them tied, the first pulse broke 353 and the other 3
resolved on their own before it was due.  No round needed a second
pulse and the link was up within 11.9 s in the worst case instead of
never.
---
 drivers/net/phy/mediatek/mtk-ge.c | 134 +++++++++++++++++++++++++++++-
 1 file changed, 132 insertions(+), 2 deletions(-)

diff --git a/drivers/net/phy/mediatek/mtk-ge.c b/drivers/net/phy/mediatek/mtk-ge.c
index 96d8ac5154e5..4fe0c7007cc0 100644
--- a/drivers/net/phy/mediatek/mtk-ge.c
+++ b/drivers/net/phy/mediatek/mtk-ge.c
@@ -2,6 +2,10 @@
 #include <linux/bitfield.h>
 #include <linux/module.h>
 #include <linux/phy.h>
+#include <linux/crc32.h>
+#include <linux/etherdevice.h>
+#include <linux/netdevice.h>
+#include <linux/workqueue.h>
 
 #include "mtk.h"
 
@@ -124,6 +128,130 @@ static int mt7531_phy_config_init(struct phy_device *phydev)
 	return 0;
 }
 
+#define MT7531_LINK_WAIT	msecs_to_jiffies(5000)
+#define MT7531_PULSE		msecs_to_jiffies(300)
+#define MT7531_BACKOFF_STEP	250
+#define MT7531_MAX_ROUNDS	16
+
+struct mt7531_phy_priv {
+	struct phy_device *phydev;
+	struct delayed_work watch;
+	unsigned int round;
+	bool in_pulse;
+};
+
+static unsigned long mt7531_phy_backoff(struct phy_device *phydev,
+					unsigned int round)
+{
+	struct net_device *ndev = phydev->attached_dev;
+	unsigned int nibble;
+	u32 key;
+
+	if (ndev)
+		key = crc32_le(~0, ndev->dev_addr, ETH_ALEN);
+	else
+		key = phydev->mdio.addr;
+
+	nibble = (key >> (4 * (round & 7))) & 0xf;
+
+	return msecs_to_jiffies(MT7531_BACKOFF_STEP * nibble);
+}
+
+static void mt7531_phy_watch(struct work_struct *work)
+{
+	struct mt7531_phy_priv *priv = container_of(work, struct mt7531_phy_priv,
+						    watch.work);
+	struct phy_device *phydev = priv->phydev;
+	int bmsr, exp;
+
+	mutex_lock(&phydev->lock);
+
+	if (priv->in_pulse) {
+		priv->in_pulse = false;
+		genphy_resume(phydev);
+		schedule_delayed_work(&priv->watch, MT7531_LINK_WAIT +
+				      mt7531_phy_backoff(phydev, priv->round));
+		goto out;
+	}
+
+	if (phydev->state < PHY_UP || phydev->autoneg != AUTONEG_ENABLE)
+		goto out;
+
+	/* Link status is latched low, read it twice. */
+	bmsr = phy_read(phydev, MII_BMSR);
+	if (bmsr >= 0)
+		bmsr = phy_read(phydev, MII_BMSR);
+	exp = phy_read(phydev, MII_EXPANSION);
+	if (bmsr < 0 || exp < 0)
+		goto out;
+
+	if (bmsr & BMSR_LSTATUS)
+		goto out;
+
+	/* Nobody on the other end, nothing to break. */
+	if (!(exp & EXPANSION_LCWP))
+		goto out;
+
+	if (priv->round >= MT7531_MAX_ROUNDS)
+		goto out;
+
+	priv->round++;
+	priv->in_pulse = true;
+	genphy_suspend(phydev);
+	schedule_delayed_work(&priv->watch, MT7531_PULSE);
+out:
+	mutex_unlock(&phydev->lock);
+}
+
+static int mt7531_phy_resume(struct phy_device *phydev)
+{
+	struct mt7531_phy_priv *priv = phydev->priv;
+	int ret;
+
+	ret = genphy_resume(phydev);
+	if (ret)
+		return ret;
+
+	priv->round = 0;
+	priv->in_pulse = false;
+	mod_delayed_work(system_wq, &priv->watch,
+			 MT7531_LINK_WAIT + mt7531_phy_backoff(phydev, 0));
+
+	return 0;
+}
+
+static int mt7531_phy_suspend(struct phy_device *phydev)
+{
+	struct mt7531_phy_priv *priv = phydev->priv;
+
+	cancel_delayed_work_sync(&priv->watch);
+	priv->in_pulse = false;
+
+	return genphy_suspend(phydev);
+}
+
+static int mt7531_phy_probe(struct phy_device *phydev)
+{
+	struct mt7531_phy_priv *priv;
+
+	priv = devm_kzalloc(&phydev->mdio.dev, sizeof(*priv), GFP_KERNEL);
+	if (!priv)
+		return -ENOMEM;
+
+	priv->phydev = phydev;
+	INIT_DELAYED_WORK(&priv->watch, mt7531_phy_watch);
+	phydev->priv = priv;
+
+	return 0;
+}
+
+static void mt7531_phy_remove(struct phy_device *phydev)
+{
+	struct mt7531_phy_priv *priv = phydev->priv;
+
+	cancel_delayed_work_sync(&priv->watch);
+}
+
 static struct phy_driver mtk_gephy_driver[] = {
 	{
 		PHY_ID_MATCH_EXACT(MTK_GPHY_ID_MT7530),
@@ -143,14 +271,16 @@ static struct phy_driver mtk_gephy_driver[] = {
 	{
 		PHY_ID_MATCH_EXACT(MTK_GPHY_ID_MT7531),
 		.name		= "MediaTek MT7531 PHY",
+		.probe		= mt7531_phy_probe,
+		.remove		= mt7531_phy_remove,
 		.config_init	= mt7531_phy_config_init,
 		/* Interrupts are handled by the switch, not the PHY
 		 * itself.
 		 */
 		.config_intr	= genphy_no_config_intr,
 		.handle_interrupt = genphy_handle_interrupt_no_ack,
-		.suspend	= genphy_suspend,
-		.resume		= genphy_resume,
+		.suspend	= mt7531_phy_suspend,
+		.resume		= mt7531_phy_resume,
 		.read_page	= mtk_phy_read_page,
 		.write_page	= mtk_phy_write_page,
 	},
