From f587a37b363dccb88a058fe69584c8854ad1927f Mon Sep 17 00:00:00 2001
From: Joachim Wiberg <troglobit@gmail.com>
Date: Sun, 18 Oct 2026 14:14:05 +0200
Subject: [PATCH 130/133] net: sparx5: let the bridge forward IGMP

IGMP never crosses a sparx5 bridge.  With three bridges in a chain, the
middle one never learns a group joined behind the last one, and none of
them hears the querier's queries from the others:

    host -- br0 -- br1 -- br2 -- receiver

The ports redirect IGMP to the CPU, CPU_IGMP_REDIR_ENA is set in
ANA_CL:PORT:CAPTURE_CFG, so the switch does not forward it.  The driver
still marks every frame from a bridged port with offload_fwd_mark, so the
bridge does not forward it either.

Leave IGMP unmarked when the port redirects it, like lan966x does.

Signed-off-by: Joachim Wiberg <troglobit@gmail.com>
---
 .../microchip/sparx5/lan969x/lan969x_fdma.c   |  4 +-
 .../ethernet/microchip/sparx5/sparx5_fdma.c   |  6 +--
 .../ethernet/microchip/sparx5/sparx5_main.h   |  1 +
 .../microchip/sparx5/sparx5_main_regs.h       | 11 +++++
 .../ethernet/microchip/sparx5/sparx5_packet.c | 46 ++++++++++++++++---
 5 files changed, 54 insertions(+), 14 deletions(-)

diff --git a/drivers/net/ethernet/microchip/sparx5/lan969x/lan969x_fdma.c b/drivers/net/ethernet/microchip/sparx5/lan969x/lan969x_fdma.c
index 1282f5c3ee6d..995bb5603239 100644
--- a/drivers/net/ethernet/microchip/sparx5/lan969x/lan969x_fdma.c
+++ b/drivers/net/ethernet/microchip/sparx5/lan969x/lan969x_fdma.c
@@ -132,9 +132,7 @@ static struct sk_buff *lan969x_fdma_rx_get_frame(struct sparx5 *sparx5,
 
 	sparx5_ptp_rxtstamp(sparx5, skb, fi.timestamp);
 	skb->protocol = eth_type_trans(skb, skb->dev);
-
-	if (test_bit(port->portno, sparx5->bridge_mask))
-		skb->offload_fwd_mark = 1;
+	sparx5_rx_fwd_mark(port, skb);
 
 	skb->dev->stats.rx_bytes += skb->len;
 	skb->dev->stats.rx_packets++;
diff --git a/drivers/net/ethernet/microchip/sparx5/sparx5_fdma.c b/drivers/net/ethernet/microchip/sparx5/sparx5_fdma.c
index dbe86f937b21..f360ba2293be 100644
--- a/drivers/net/ethernet/microchip/sparx5/sparx5_fdma.c
+++ b/drivers/net/ethernet/microchip/sparx5/sparx5_fdma.c
@@ -168,11 +168,7 @@ static bool sparx5_fdma_rx_get_frame(struct sparx5 *sparx5, struct sparx5_rx *rx
 
 	sparx5_ptp_rxtstamp(sparx5, skb, fi.timestamp);
 	skb->protocol = eth_type_trans(skb, skb->dev);
-	/* Everything we see on an interface that is in the HW bridge
-	 * has already been forwarded
-	 */
-	if (test_bit(port->portno, sparx5->bridge_mask))
-		skb->offload_fwd_mark = 1;
+	sparx5_rx_fwd_mark(port, skb);
 	skb->dev->stats.rx_bytes += skb->len;
 	skb->dev->stats.rx_packets++;
 	rx->packets++;
diff --git a/drivers/net/ethernet/microchip/sparx5/sparx5_main.h b/drivers/net/ethernet/microchip/sparx5/sparx5_main.h
index 9d2a96eccfb2..18fa9075d8f6 100644
