From 928b819b4ce50e6ae92210f1179c2aaa9df16f5f Mon Sep 17 00:00:00 2001
From: Joachim Wiberg <troglobit@gmail.com>
Date: Thu, 15 Oct 2026 11:15:52 +0200
Subject: [PATCH 127/132] net: sparx5: ignore switchdev attributes of uppers
 and other bridges

Bridging a VLAN interface on top of a standalone port fills the log with

  sparx5-switch e00c0000.switch e5: Controlling non-bridged port 7?

The switchdev helper passes the attributes of a bridge port down to the
lower sparx5 port, so the bridge settings of the VLAN interface are
applied to a port that is in no bridge: its STP state, flood flags,
VLAN filtering and ageing time.

Only handle an attribute when it is for the port itself, or for the
bridge the port is offloaded to.

Signed-off-by: Joachim Wiberg <troglobit@gmail.com>
---
 drivers/net/ethernet/microchip/sparx5/sparx5_switchdev.c | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/drivers/net/ethernet/microchip/sparx5/sparx5_switchdev.c b/drivers/net/ethernet/microchip/sparx5/sparx5_switchdev.c
index e87a343e150c..a56b5a83f814 100644
--- a/drivers/net/ethernet/microchip/sparx5/sparx5_switchdev.c
+++ b/drivers/net/ethernet/microchip/sparx5/sparx5_switchdev.c
@@ -137,6 +137,15 @@ static int sparx5_port_attr_set(struct net_device *dev, const void *ctx,
 				struct netlink_ext_ack *extack)
 {
 	struct sparx5_port *port = netdev_priv(dev);
+	struct sparx5 *sparx5 = port->sparx5;
+
+	/* Attributes of an upper in a bridge, e.g. a VLAN interface on the
+	 * port, or of a bridge the port is not in, are not ours.
+	 */
+	if (attr->orig_dev != dev &&
+	    (attr->orig_dev != sparx5->hw_bridge_dev ||
+	     !test_bit(port->portno, sparx5->bridge_mask)))
+		return -EOPNOTSUPP;
 
 	switch (attr->id) {
 	case SWITCHDEV_ATTR_ID_PORT_PRE_BRIDGE_FLAGS:
