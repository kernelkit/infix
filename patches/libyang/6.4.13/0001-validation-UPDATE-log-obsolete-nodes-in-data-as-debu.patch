From 23b3b7c330070764e88e674ebd067cec6aa70784 Mon Sep 17 00:00:00 2001
From: Joachim Wiberg <troglobit@gmail.com>
Date: Mon, 1 Sep 2025 14:24:03 +0200
Subject: [PATCH 1/2] validation UPDATE log obsolete nodes in data as debug
Organization: Wires

Every obsolete schema node instantiated in data is logged as a warning,
each time the data is validated.  An application that keeps such nodes
on purpose, e.g., to migrate them to their replacement, has no way to
silence it short of dropping all warnings.

Log the message in a new debug group, LY_LDGSCHEMA, which applications
can enable when they want to know.

Signed-off-by: Joachim Wiberg <troglobit@gmail.com>
---
 src/log.c        | 3 +++
 src/log.h        | 1 +
 src/validation.c | 2 +-
 3 files changed, 5 insertions(+), 1 deletion(-)

diff --git a/src/log.c b/src/log.c
index 4cca02d7d..d7aa7be60 100644
--- a/src/log.c
+++ b/src/log.c
@@ -621,6 +621,9 @@ ly_log_dbg(uint32_t group, const char *format, ...)
     case LY_LDGDEPSETS:
         str_group = "DEPSETS";
         break;
+    case LY_LDGSCHEMA:
+        str_group = "SCHEMA";
+        break;
     default:
         LOGINT(NULL);
         return;
diff --git a/src/log.h b/src/log.h
index 9b0692f75..e9492e985 100644
--- a/src/log.h
+++ b/src/log.h
@@ -159,6 +159,7 @@ LIBYANG_API_DECL uint32_t *ly_temp_log_options(uint32_t *opts);
 #define LY_LDGDICT      0x01    /**< Dictionary additions and deletions. */
 #define LY_LDGXPATH     0x02    /**< XPath parsing end evaluation. */
 #define LY_LDGDEPSETS   0x04    /**< Dependency module sets for schema compilation. */
+#define LY_LDGSCHEMA    0x08    /**< Schema compilation and validation. */
 
 /**
  * @}
diff --git a/src/validation.c b/src/validation.c
index eb03b1818..04724f477 100644
--- a/src/validation.c
+++ b/src/validation.c
@@ -1703,7 +1703,7 @@ lyd_validate_obsolete(const struct lyd_node *node)
     snode = node->schema;
     do {
         if (snode->flags & LYS_STATUS_OBSLT && (!(snode->nodetype & LYD_NODE_INNER) || lyd_child(node))) {
-            LOGWRN(snode->module->ctx, "Obsolete schema node \"%s\" instantiated in data.", snode->name);
+            LOGDBG(LY_LDGSCHEMA, "%s: obsolete schema node \"%s\" instantiated in data.", snode->module->name, snode->name);
             break;
         }
 
