#!/bin/sh

IFQUIRKSFILE=${IFQUIRKSFILE:-/etc/product/interface-quirks.json}

if [ $# -lt 2 ]; then
        echo "usage: $0 <quirk-name> <ifname>"
        exit 1
fi

quirk=$1
ifname=$2

# Patterns setting the quirk, built-in ones for pluggable hardware
# overridden by the product's
patterns=$(cat /etc/interface-quirks.json "$IFQUIRKSFILE" 2>/dev/null | \
	   jq -rs --arg quirk "$quirk" \
	      'add // {} | to_entries[] | select(.value[$quirk]) | .key')

# Radios have no netdev for ethtool, report their driver the same way
drvinfo()
{
    phy=/sys/class/ieee80211/$ifname
    if [ -d "$phy" ]; then
	echo "driver: $(basename "$(readlink "$phy/device/driver")")"
    else
	ethtool -i "$ifname"
    fi
}

ethtoolmatch()
{
    local pattern="${1#@ethtool:}"

    # All key=val pairs of the pattern must match a "key: val" line
    drvinfo | awk -v pat="$pattern" '
	BEGIN {
		n = split(pat, kv, ";");
		for (i = 1; i <= n; i++) {
			eq = index(kv[i], "=");
			want[substr(kv[i], 1, eq - 1) ": " substr(kv[i], eq + 1)] = 1;
		}
	}
	($0 in want) { delete want[$0]; found++; }
	END { exit(found < n); }
    '
}


for pattern in $patterns; do
    case "$pattern" in
	@ethtool:*)
	    ethtoolmatch "$pattern" || continue
	    ;;
	"$ifname")
	    ;;
	*)
	    continue
	    ;;
    esac
    echo true
    exit 0
done

echo "false"
