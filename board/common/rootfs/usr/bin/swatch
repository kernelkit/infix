#!/bin/sh
# Watch how the counters in a command's "name value" output change over time

usage()
{
    cat <<EOF
usage: ${0##*/} MODE COMMAND [ARG...]

Run COMMAND, which prints one "name value" counter per line, and show
the counters that changed since the baseline, with their deltas.

Modes:
  base, baseline     Record a new baseline and exit
  single             Show changes since the baseline once and exit
  incr, incremental  Every second, show changes since the baseline
  ival, interval     Every second, show changes since the last sample

A baseline is recorded first if none exists for COMMAND.

Example:
  ${0##*/} ival ethtool -S eth0
EOF
}

case $1 in
    base|baseline) mode="baseline" ;;
    incr|incremental) mode="incremental" ;;
    ival|interval) mode="interval" ;;
    single) mode="single" ;;
    -h|--help) usage; exit 0 ;;
    *) usage >&2; exit 1 ;;
esac
shift

if [ $# -eq 0 ]; then
    usage >&2
    exit 1
fi

slug=$(echo $* | tr ' ' '_' | tr -cd '[a-zA-Z0-9]-_')
baseline=/tmp/swatch-"$slug"
now=/tmp/swatch-"$slug".now

output()
{
    diff -u -U0 "$baseline" "$now" | awk '
	/^\-[^-]/ {
		sub(/^-/, "");
		last[$1] = $2;
	}
	/^\+[^+]/ {
		sub(/^\+/, "");
		diff = $2 - last[$1];
		if (diff)
			printf("%-60s %10d\n", $1, diff);
	}
    '
}

if [ $mode = baseline ] || ! [ -f "$baseline" ]; then
    $@ >"$baseline"
    [ $mode = baseline ] && exit
fi

if [ $mode = single ]; then
    $@ >"$now"
    output
    exit
fi

while sleep 1; do
    $@ >"$now"

    printf '\e[2J\e[H'
    output
    [ $mode = interval ] && mv "$now" "$baseline"
done
