menuconfig IX_IMAGE_GNS3A
	bool "GNS3 Appliance"
	depends on BR2_x86_64
	depends on IX_IMAGE_DDI_DISK || IX_IMAGE_ITB_QCOW
	help
	  Create a GNS3 appliance description that, together with the
	  disk image, can be imported into GNS3.  The UEFI firmware is
	  the one from the GNS3 registry, GNS3 downloads it on import.

config IX_IMAGE_GNS3A_RAM
	int "Reserved RAM (MiB)"
	depends on IX_IMAGE_GNS3A
	default "512"
	help
	  Amount of host RAM reserved for an appliance instance.

config IX_IMAGE_GNS3A_IFNUM
	int "Number of interfaces"
	depends on IX_IMAGE_GNS3A
	default "10"
	help
	  Number of Ethernet interfaces to create for an appliance instance.
