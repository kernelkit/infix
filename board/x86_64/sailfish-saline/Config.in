config BR2_PACKAGE_SAILFISH_SALINE
	bool "Sailfish Saline"
	depends on BR2_x86_64
	select BR2_PACKAGE_FEATURE_TSN
	select BR2_PACKAGE_MODULES
	select BR2_PACKAGE_MODULES_PTP_PG210_PTP
	select BR2_PACKAGE_MODULES_NET_DSA_PASW
	select BR2_PACKAGE_MODULES_NET_DSA_PASW_TOOL
	select BR2_PACKAGE_MODULES_NET_ETH_XDMA_NET
	help
	  Saline board from Sailfish
